# PicPeak Environment Configuration — 8digit Creative
# gallery.8digitcreative.com

# Environment
NODE_ENV=

# JWT Secret
JWT_SECRET=

# Database Configuration (PostgreSQL)
DATABASE_CLIENT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# Redis Configuration
REDIS_PASSWORD=

# Admin Account (initial setup)
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Email Configuration
# Webhook mode: emails sent via n8n instead of SMTP (DO blocks SMTP ports)
EMAIL_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Application URLs
FRONTEND_URL=
ADMIN_URL=
API_URL=
VITE_API_URL=

# Release Channel
PICPEAK_CHANNEL=
UPDATE_CHECK_ENABLED=

# Timezone
TZ=

# Runtime user mapping
PUID=
PGID=

# Storage (host paths — relative to project root on the droplet)
APP_STORAGE=
APP_DATA=
LOGS=

# Analytics (Optional - Umami)
VITE_UMAMI_URL=
VITE_UMAMI_WEBSITE_ID=
VITE_UMAMI_SHARE_URL=
